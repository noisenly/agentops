#!/usr/bin/env python3
"""Local launcher for Mission Control: starts one impl-N agent per in-progress issue.

Deliberately tiny attack surface: loopback only, bearer token, and exactly one
fixed action. The caller cannot choose the command, the repo, or the prompt.

  AGENT_RUNNER_TOKEN=... agent-runner            # serve on 127.0.0.1:4390
  POST /launch-issues   Authorization: Bearer <token>
"""
import hmac
import json
import os
import re
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HERE = Path(__file__).resolve().parent
OBSERVE = HERE / "agent-observe"
REPO = Path(os.environ.get("AGENT_RUNNER_REPO", Path.home() / "Developer/Skillvue/skillvue-showroom-monorepo"))
PORT = int(os.environ.get("AGENT_RUNNER_PORT", "4390"))
TOKEN = os.environ.get("AGENT_RUNNER_TOKEN", "")
LEADER = "demo_leader"
# ponytail: one prompt for every issue; per-issue prompts when the harness needs them.
PROMPT = (
    "You are impl-{n}, the implementer for GitHub Issue #{n}. Follow demo-harness/AGENTS.md: "
    "implement exactly this Issue in your own worktree, write its executable check, self-verify, "
    "rebase onto origin/master and open a PR. Do not review or merge."
)


def issue_numbers():
    """Refresh the Lattice issue nodes, then read back the in-progress issue numbers."""
    subprocess.run([REPO / "scripts/lattice-sync.sh"], cwd=REPO, check=True, capture_output=True)
    table = (REPO / "demo-harness/issue-agents.md").read_text()
    return [int(n) for n in re.findall(r"^\| impl-(\d+) \|", table, re.M)]


def launch(n):
    env = {
        **os.environ,
        "AGENT_OBSERVER_AGENT_NAME": f"impl-{n}",
        "AGENT_OBSERVER_PARENT_ID": LEADER,
        "AGENT_OBSERVER_ROLE": "worker",
    }
    env.pop("AGENT_RUNNER_TOKEN", None)  # the agent never needs the runner's token
    log = open(REPO / f".git/agent-runner-impl-{n}.log", "ab")
    proc = subprocess.Popen(
        [OBSERVE, "claude", "-p", "--worktree", f"impl-{n}", "--permission-mode", "auto", PROMPT.format(n=n)],
        cwd=REPO, env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
    )
    return proc.pid


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        if self.path != "/launch-issues":
            return self.reply(404, {"error": "not found"})
        supplied = self.headers.get("Authorization", "").removeprefix("Bearer ")
        if not TOKEN or not hmac.compare_digest(supplied.encode(), TOKEN.encode()):
            return self.reply(401, {"error": "unauthorized"})
        try:
            launched = [{"agent": f"impl-{n}", "issue": n, "pid": launch(n)} for n in issue_numbers()]
        except (OSError, subprocess.CalledProcessError) as exc:
            return self.reply(500, {"error": str(exc)})
        self.reply(200, {"launched": launched})

    def reply(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


if __name__ == "__main__":
    if not TOKEN:
        raise SystemExit("agent-runner: set AGENT_RUNNER_TOKEN")
    print(f"agent-runner on 127.0.0.1:{PORT} for {REPO}")
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
